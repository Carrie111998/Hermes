{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Herbie Active Task Supervisor Event",
  "type": "object",
  "additionalProperties": true,
  "required": ["at", "task_id", "event"],
  "properties": {
    "at": { "type": "string" },
    "task_id": { "type": ["string", "null"] },
    "event": {
      "type": "string",
      "enum": [
        "state_transition",
        "owner_notification_created",
        "owner_notification_attempted",
        "owner_notification_failed",
        "owner_notification_delivered",
        "internal_nudge_recorded",
        "checkpoint_recorded",
        "watchdog_failure",
        "manual_update",
        "queue_promoted"
      ]
    },
    "from": { "type": ["string", "null"] },
    "to": { "type": ["string", "null"] },
    "kind": { "type": ["string", "null"] },
    "incident_key": { "type": ["string", "null"] },
    "transport": { "type": ["string", "null"] },
    "provider_id": { "type": ["string", "null"] },
    "detail": { "type": ["string", "null"] }
  }
}
