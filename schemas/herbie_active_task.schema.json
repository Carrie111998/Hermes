{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Herbie Active Task Ledger Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "title",
    "owner",
    "spec_filename",
    "spec_path",
    "spec_version",
    "spec_sha256",
    "status",
    "created_at",
    "started_at",
    "last_progress_at",
    "last_owner_update_at",
    "next_required_owner_update_at",
    "current_step",
    "next_step",
    "percent_or_stage_complete",
    "blocker_type",
    "blocker_detail",
    "checkpoint_commit",
    "checkpoint_artifact_path",
    "tool_budget_risk",
    "owner_notification_state",
    "internal_nudge_state",
    "completion_artifact",
    "closed_at"
  ],
  "properties": {
    "task_id": { "type": "string", "pattern": "^HERBIE-[0-9]{8}-[0-9]{4}-[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "spec_filename": { "type": "string", "minLength": 1 },
    "spec_path": { "type": "string", "minLength": 1 },
    "spec_version": { "type": "string", "minLength": 1 },
    "spec_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": {
      "type": "string",
      "enum": [
        "RECEIVED",
        "PREFLIGHT",
        "ACTIVE",
        "BLOCKED",
        "WAITING_OWNER",
        "READY_FOR_INDEPENDENT_REVIEW",
        "COMPLETE",
        "ABORTED",
        "QUEUED"
      ]
    },
    "created_at": { "type": "string" },
    "started_at": { "type": ["string", "null"] },
    "last_progress_at": { "type": ["string", "null"] },
    "last_owner_update_at": { "type": ["string", "null"] },
    "next_required_owner_update_at": { "type": ["string", "null"] },
    "current_step": { "type": ["string", "null"] },
    "next_step": { "type": ["string", "null"] },
    "percent_or_stage_complete": { "type": ["string", "number", "null"] },
    "blocker_type": { "type": ["string", "null"] },
    "blocker_detail": { "type": ["string", "null"] },
    "checkpoint_commit": { "type": ["string", "null"] },
    "checkpoint_artifact_path": { "type": ["string", "null"] },
    "tool_budget_risk": { "type": ["string", "null"] },
    "owner_notification_state": { "type": ["string", "null"] },
    "internal_nudge_state": { "type": ["object", "null"] },
    "completion_artifact": { "type": ["string", "null"] },
    "closed_at": { "type": ["string", "null"] }
  }
}
