# Required by docker-compose.yml. Copy to .env and replace the placeholders.
# These are host IDs, not the image's internal default IDs.
HERMES_UID=
HERMES_GID=

# Absolute path to the persistent Hermes profile used by the running host.
# An absolute path prevents sudo/docker-compose HOME drift to /root.
HERMES_DATA_DIR=/home/deploy/.hermes
