    },
    {
      "name": "hermes-health",
      "command": "curl -fsS http://127.0.0.1:3000/health >/tmp/christopher-hermes-health.json && python3 - <<'PY2'\nimport json\np=json.load(open('/tmp/christopher-hermes-health.json'))\nassert p.get('status') in ('ok','healthy')\nPY2"
    },
    {
      "name": "whatsapp-v2-health",
      "command": "curl -fsS http://127.0.0.1:3001/health >/tmp/christopher-wa-v2-health.json && python3 - <<'PY2'\nimport json\np=json.load(open('/tmp/christopher-wa-v2-health.json'))\nassert p.get('connected') is True\nassert p.get('paired') is True\nPY2"
    },
    {
      "name": "config-constitution-present",
      "command": "test -s /home/pclaw/.hermes-christopher-tgg-state/config.yaml && test -s /home/pclaw/.hermes-christopher-tgg-state/christopher_tgg_constitution.yaml"
    },
    {
      "name": "model-config",
      "command": "grep -q 'default: gemini-3-flash-preview' /home/pclaw/.hermes-christopher-tgg/config.yaml"
    },
    {
      "name": "outbound-disabled",
      "command": "systemctl show christopher-tgg-whatsapp.service --property=Environment --value | tr ' ' '\\n' | grep -qx 'WHATSAPP_OUTBOUND_DISABLED=true'"
