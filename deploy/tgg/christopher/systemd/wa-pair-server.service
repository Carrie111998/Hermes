[Unit]
Description=Christopher WA pairing QR HTTP page (tailnet :8089)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/wa-pair-server.py
Restart=always
RestartSec=3
StandardOutput=append:/var/log/wa-pair-server.log
StandardError=append:/var/log/wa-pair-server.log

[Install]
WantedBy=multi-user.target
