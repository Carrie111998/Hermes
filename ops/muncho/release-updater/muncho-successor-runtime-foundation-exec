#!/bin/sh
set -eu

fixed_wrapper=/usr/libexec/muncho-successor-runtime-foundation-exec
library_base=/usr/lib/muncho-release-updater-releases
builder_uid=29104
builder_gid=29104

if [ "$#" -lt 5 ]; then
  exit 2
fi

operation=$1
revision=$2
expected_wrapper_sha256=$3
expected_launcher_sha256=$4
expected_controller_manifest_file_sha256=$5
shift 5

if [ "${#revision}" -ne 40 ] || [ "${#expected_wrapper_sha256}" -ne 64 ] || [ "${#expected_launcher_sha256}" -ne 64 ] || [ "${#expected_controller_manifest_file_sha256}" -ne 64 ]; then
  exit 2
fi
case "$revision$expected_wrapper_sha256$expected_launcher_sha256$expected_controller_manifest_file_sha256" in
  *[!0-9a-f]*) exit 2 ;;
esac
if [ "$0" != "$fixed_wrapper" ] || [ -L "$fixed_wrapper" ]; then
  exit 2
fi
if [ "$(/usr/bin/id -u)" != 0 ] || [ "$(/usr/bin/id -g)" != 0 ]; then
  exit 2
fi
if [ "$(/usr/bin/stat --format='%u:%g:%a:%h' -- "$fixed_wrapper")" != "0:0:555:1" ]; then
  exit 2
fi
observed_wrapper_sha256=$(
  /usr/bin/sha256sum -- "$fixed_wrapper" | /usr/bin/cut -d ' ' -f 1
)
if [ "$observed_wrapper_sha256" != "$expected_wrapper_sha256" ]; then
  exit 2
fi

library="$library_base/$revision"
controller="$library/controller"
launcher="$controller/scripts/canary/production_successor_rebind_owner_runtime_launcher.py"
if [ -L "$library_base" ] || [ -L "$library" ] || [ -L "$controller" ] || [ -L "$launcher" ]; then
  exit 2
fi
if [ "$(/usr/bin/stat --format='%u:%g:%a' -- "$library_base")" != "0:0:755" ] || [ "$(/usr/bin/stat --format='%u:%g:%a' -- "$library")" != "0:0:555" ]; then
  exit 2
fi
if [ "$(/usr/bin/stat --format='%u:%g:%a' -- "$controller")" != "0:0:555" ]; then
  exit 2
fi
if [ "$(/usr/bin/stat --format='%u:%g:%a:%h' -- "$launcher")" != "0:0:444:1" ]; then
  exit 2
fi
observed_launcher_sha256=$(
  /usr/bin/sha256sum -- "$launcher" | /usr/bin/cut -d ' ' -f 1
)
if [ "$observed_launcher_sha256" != "$expected_launcher_sha256" ]; then
  exit 2
fi

case "$operation" in
  prepare-runtime)
    if [ "$#" -ne 0 ]; then
      exit 2
    fi
    exec /usr/bin/python3 -I -S -B "$launcher" prepare-runtime "$revision" "$expected_controller_manifest_file_sha256"
    ;;
  build-runtime-as-dedicated-builder)
    if [ "$#" -ne 2 ] || [ "${#1}" -ne 40 ] || [ "${#2}" -ne 64 ]; then
      exit 2
    fi
    case "$1$2" in
      *[!0-9a-f]*) exit 2 ;;
    esac
    if [ ! -x /usr/bin/setpriv ] || [ -L /usr/bin/setpriv ]; then
      exit 2
    fi
    # The first target/build Python instruction is reached only after the
    # fixed numeric identity and supplementary groups have been replaced.
    exec /usr/bin/setpriv \
      --reuid="$builder_uid" \
      --regid="$builder_gid" \
      --clear-groups \
      --inh-caps=-all \
      --ambient-caps=-all \
      --bounding-set=-all \
      --no-new-privs \
      -- \
      /usr/bin/env -i \
      HOME=/nonexistent \
      LANG=C.UTF-8 \
      LC_ALL=C.UTF-8 \
      PATH=/usr/bin:/bin:/usr/sbin:/sbin \
      /usr/bin/python3 -I -S -B "$launcher" \
      build-runtime-as-dedicated-builder "$revision" "$expected_controller_manifest_file_sha256" "$1" "$2"
    ;;
  promote-runtime)
    if [ "$#" -ne 0 ]; then
      exit 2
    fi
    exec /usr/bin/python3 -I -S -B "$launcher" promote-runtime "$revision" "$expected_controller_manifest_file_sha256"
    ;;
  *)
    exit 2
    ;;
esac
