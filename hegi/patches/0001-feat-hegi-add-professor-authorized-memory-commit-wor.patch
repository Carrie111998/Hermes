+                    else None
+                ),
+            },
+        }
+
+    def approve(self, draft_id: str, *, note: str):
+        self.calls.append(f"approve:{draft_id}")
+        return {"ok": True, "draft_id": draft_id, "state": "approved"}
+
+    def commit(self, draft_id: str):
+        self.calls.append(f"commit:{draft_id}")
+        self.commits += 1
+        return {
