+        lambda _root: (["uv", "pip", "install"], {}),
+    )
+    monkeypatch.setattr(
+        update_generation_worker,
+        "_optional_groups",
+        lambda _root: ["alpha", "beta"],
+    )
+
+    def fake_run(command, *, cwd, env):
+        commands.append(command)
+        if command[-1] == ".[all]":
+            return 1
+        if command[-1] == ".[beta]":
+            return 1
+        return 0
+
+    monkeypatch.setattr(update_generation_worker, "_run", fake_run)
