+    assert ok is True
+    assert failures == ["beta"]
+    assert receipt == {"main": "verified"}
+    assert commands == [
+        ["uv", "pip", "install", "-e", ".[all]"],
+        ["uv", "pip", "install", "-e", "."],
+        ["uv", "pip", "install", "-e", ".[alpha]"],
+        ["uv", "pip", "install", "-e", ".[beta]"],
+    ]
