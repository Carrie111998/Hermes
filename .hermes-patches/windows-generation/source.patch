@@ -0,0 +1,525 @@
+from __future__ import annotations
+
+import importlib.util
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[2]
+MODULE = ROOT / "hermes_cli" / "update_generation.py"
+WORKER_MODULE = ROOT / "hermes_cli" / "update_generation_worker.py"
+
+spec = importlib.util.spec_from_file_location("update_generation", MODULE)
+assert spec and spec.loader
+update_generation = importlib.util.module_from_spec(spec)
+sys.modules["update_generation"] = update_generation
+spec.loader.exec_module(update_generation)
+
+worker_spec = importlib.util.spec_from_file_location(
+    "update_generation_worker", WORKER_MODULE
+)
+assert worker_spec and worker_spec.loader
+update_generation_worker = importlib.util.module_from_spec(worker_spec)
+worker_spec.loader.exec_module(update_generation_worker)
+
+
+def _repo(tmp_path: Path) -> tuple[Path, str, str]:
+    root = tmp_path / "home" / "hermes-agent"
+    root.mkdir(parents=True)
+    subprocess.run(["git", "init", "-q"], cwd=root, check=True)
+    subprocess.run(["git", "config", "user.name", "test"], cwd=root, check=True)
+    subprocess.run(["git", "config", "user.email", "test@example.com"], cwd=root, check=True)
+    (root / "tracked.txt").write_text("n\n", encoding="utf-8")
+    subprocess.run(["git", "add", "tracked.txt"], cwd=root, check=True)
+    subprocess.run(["git", "commit", "-qm", "n"], cwd=root, check=True)
+    previous = subprocess.check_output(
+        ["git", "rev-parse", "HEAD"], cwd=root, encoding="ascii"
+    ).strip()
+    (root / "tracked.txt").write_text("n+1\n", encoding="utf-8")
+    subprocess.run(["git", "add", "tracked.txt"], cwd=root, check=True)
+    subprocess.run(["git", "commit", "-qm", "n+1"], cwd=root, check=True)
+    target = subprocess.check_output(
+        ["git", "rev-parse", "HEAD"], cwd=root, encoding="ascii"
+    ).strip()
+    return root, previous, target
+
+
+def _transaction(tmp_path: Path):
+    root, previous, target = _repo(tmp_path)
+    tx = update_generation.create_transaction(
+        project_root=root,
+        previous_sha=previous,
+        target_sha=target,
+        branch="main",
+        argv=["update", "--yes", "--gateway"],
+        pre_update_version="0.20.4",
+        pre_update_snapshot_id="snap-1",
+        had_desktop_app_before_update=True,
+        gateway_resume={"profiles": ["default"]},
+        active_lazy_features=["provider.bedrock"],
+        active_tool_dependencies=[{"name": "boto3"}],
+    )
+    return tx, root
+
+
+def test_journal_is_owner_only_atomic_and_token_bound(tmp_path, monkeypatch):
+    root, previous, target = _repo(tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(root.parent))
+    tx = update_generation.create_transaction(
+        project_root=root,
+        previous_sha=previous,
+        target_sha=target,
+        branch="main",
+        argv=["update"],
+        pre_update_version=None,
+        pre_update_snapshot_id=None,
+        had_desktop_app_before_update=False,
+        gateway_resume=None,
+        active_lazy_features=[],
+        active_tool_dependencies=[],
+    )
+
+    path = Path(tx.journal_path)
+    assert path.parent == root.parent
+    assert path.exists()
+    if os.name != "nt":
+        assert path.stat().st_mode & 0o077 == 0
+    assert not list(path.parent.glob(f".{path.name}.*.tmp"))
+    assert update_generation.read_transaction(path, token=tx.token) == tx
+    with pytest.raises(update_generation.UpdateTransactionError, match="token"):
+        update_generation.read_transaction(path, token="x" * 43)
+
+
+def test_discovery_refuses_checkout_generation_drift(tmp_path, monkeypatch):
+    tx, root = _transaction(tmp_path)
+    monkeypatch.setenv(update_generation.TRANSACTION_PATH_ENV, tx.journal_path)
+    monkeypatch.setenv(update_generation.TRANSACTION_TOKEN_ENV, tx.token)
+    assert update_generation.discover_transaction(root) == tx
+
+    (root / "tracked.txt").write_text("n+2\n", encoding="utf-8")
+    subprocess.run(["git", "add", "tracked.txt"], cwd=root, check=True)
+    subprocess.run(["git", "commit", "-qm", "n+2"], cwd=root, check=True)
+    with pytest.raises(update_generation.UpdateTransactionError, match="generation"):
+        update_generation.discover_transaction(root)
