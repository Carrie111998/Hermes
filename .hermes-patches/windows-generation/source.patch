+def test_begin_handoff_execs_worker_instead_of_spawning_and_waiting(tmp_path, monkeypatch):
+    tx, _root = _transaction(tmp_path)
+    seen = {}
+
+    def fake_execve(executable, argv, env):
+        seen.update(executable=executable, argv=argv, env=env)
+        raise RuntimeError("exec sentinel")
+
+    monkeypatch.setattr(os, "execve", fake_execve)
+    with pytest.raises(RuntimeError, match="exec sentinel"):
+        update_generation.begin_dependency_handoff(tx)
+
+    persisted = update_generation.read_transaction(Path(tx.journal_path), token=tx.token)
+    assert persisted.phase == "dependency_handoff"
+    assert persisted.parent_pid == os.getpid()
+    assert seen["argv"][1] == "-S"
+    assert seen["argv"][2].endswith("update_generation_worker.py")
+    assert "--token" not in seen["argv"]
+    assert seen["env"][update_generation.TRANSACTION_PATH_ENV] == tx.journal_path
+    assert seen["env"][update_generation.TRANSACTION_TOKEN_ENV] == tx.token
+    assert update_generation.TRANSACTION_RESUME_ENV not in seen["env"]
+
