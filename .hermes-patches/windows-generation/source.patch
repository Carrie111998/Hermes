+"""Stdlib-only dependency realization worker for ``hermes update``.
+
+This file is executed by path, not imported through ``hermes_cli.main``.  The
+old updater process has been replaced before this module starts, so no module
+from generation N and no target venv native extension remains mapped while the
+dependency graph for N+1 is realized.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+# Executing this file directly places hermes_cli/ on sys.path.  Import the
+# stdlib-only sibling without importing the full hermes_cli package.
+import update_generation as generation
+
+
+def _parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(add_help=False)
+    parser.add_argument("--journal", required=True)
+    return parser.parse_args()
+
+
+def _write_incomplete_marker(project_root: Path) -> Path:
+    marker = project_root / ".update-incomplete"
+    temp = marker.with_name(f".{marker.name}.{os.getpid()}.tmp")
+    body = (
+        f"pid={os.getpid()}\n"
+        f"created_at={int(time.time())}\n"
+        "reason=generation-bound-dependency-install\n"
+    )
+    temp.write_text(body, encoding="utf-8")
+    os.replace(temp, marker)
+    return marker
+
+
+def _optional_groups(project_root: Path) -> list[str]:
+    try:
+        import tomllib
+
+        with open(project_root / "pyproject.toml", "rb") as handle:
+            data = tomllib.load(handle)
+    except Exception:
+        return []
+    groups = (data.get("project") or {}).get("optional-dependencies") or {}
+    if not isinstance(groups, dict):
+        return []
+    # Alias/meta groups often expand to other extras and are still valid
+    # editable-install targets.  Preserve manifest order for deterministic
+    # receipts and stop only on the base install, not on one optional group.
+    return [
+        str(name)
+        for name in groups
+        if str(name).strip() and str(name) not in {"all", "termux-all"}
+    ]
+
+
+def _run(command: list[str], *, cwd: Path, env: dict[str, str]) -> int:
+    print("  $ " + " ".join(command), flush=True)
+    try:
+        result = subprocess.run(command, cwd=cwd, env=env)
+    except OSError as exc:
+        print(f"  ✗ could not launch dependency installer: {exc}", file=sys.stderr)
+        return 127
+    return int(result.returncode)
+
+
+def _pip_prefix(project_root: Path) -> tuple[list[str], dict[str, str]]:
+    env = dict(os.environ)
+    env.pop("PYTHONHOME", None)
+    env.pop("PYTHONPATH", None)
+    env["PYTHONDONTWRITEBYTECODE"] = "1"
+    env.setdefault("PIP_DISABLE_PIP_VERSION_CHECK", "1")
+    if os.name == "nt":
+        # Copy semantics are slower but avoid hardlink/reflink surprises in a
+        # venv that Windows processes and endpoint security inspect live.
+        env.setdefault("UV_LINK_MODE", "copy")
+    if (project_root / "venv").is_dir():
+        venv = project_root / "venv"
+    elif (project_root / ".venv").is_dir():
+        venv = project_root / ".venv"
+    else:
+        venv = project_root / "venv"
+    env["VIRTUAL_ENV"] = str(venv)
+    uv = generation.find_uv(project_root)
+    if not generation.venv_python(project_root).is_relative_to(venv.resolve()):
+        if not uv:
+            raise RuntimeError("managed venv is missing and uv is unavailable")
+        print("→ Recreating the managed virtual environment before dependency realization...")
+        if _run([uv, "venv", "--clear", str(venv)], cwd=project_root, env=env) != 0:
+            raise RuntimeError("managed venv recreation failed")
+    python = generation.venv_python(project_root)
+    if not python.is_relative_to(venv.resolve()):
+        raise RuntimeError("managed venv recreation did not produce its Python interpreter")
+    if uv:
+        # Name the target interpreter explicitly.  VIRTUAL_ENV remains in the
+        # environment for build hooks, but it is not the authority deciding
+        # which environment uv mutates.
+        return [uv, "pip", "install", "--python", str(python)], env
+
+    # The worker itself is stdlib-only, so invoking this interpreter does not
+    # map any target site-package extension before pip attempts replacement.
+    subprocess.run(
+        [str(python), "-m", "ensurepip", "--upgrade", "--default-pip"],
+        cwd=project_root,
+        env=env,
+        stdout=subprocess.DEVNULL,
+        stderr=subprocess.DEVNULL,
+        check=False,
+    )
+    return [str(python), "-m", "pip", "install"], env
+
+
+
+
+def _wait_for_predecessor_exit(
+    tx: generation.UpdateTransaction, *, timeout_seconds: float = 30.0
+) -> None:
+    """Fence Windows' spawn-backed ``execve`` before mutating the venv.
+
+    POSIX ``execve`` keeps one PID, but CPython's Windows overlay can briefly
+    run the replacement while process N is still exiting.  Process N may have
+    native extensions mapped from the target venv, so N+1 must prove that the
+    predecessor is gone before it invokes uv/pip.
+    """
+    if tx.parent_pid == os.getpid():
+        return
+    deadline = time.monotonic() + max(float(timeout_seconds), 0.0)
+    while generation._pid_alive(tx.parent_pid):
+        if time.monotonic() >= deadline:
+            raise generation.UpdateTransactionError(
+                f"predecessor updater PID {tx.parent_pid} did not exit before dependency mutation"
+            )
+        time.sleep(0.05)
+
+
+def _verify_target_environment(
+    project_root: Path, env: dict[str, str]
+) -> tuple[bool, dict[str, str] | str]:
+    """Prove the interpreter users will execute can import this checkout."""
+    python = generation.venv_python(project_root)
+    expected_root = str(project_root.resolve())
+    probe = r"""
+import json
+import os
+import pathlib
+import sys
+
+expected = pathlib.Path(os.environ["HERMES_EXPECTED_PROJECT_ROOT"]).resolve()
+import hermes_cli.main as main_module
+import yaml
+import cryptography
+
+module_path = pathlib.Path(main_module.__file__).resolve()
+if expected != module_path and expected not in module_path.parents:
+    raise SystemExit(41)
+print(json.dumps({
+    "executable": sys.executable,
+    "prefix": sys.prefix,
+    "main": str(module_path),
+}, sort_keys=True))
+"""
+    probe_env = dict(env)
+    probe_env["HERMES_EXPECTED_PROJECT_ROOT"] = expected_root
+    try:
+        result = subprocess.run(
+            [str(python), "-I", "-c", probe],
+            cwd=project_root,
+            env=probe_env,
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+            errors="replace",
+            timeout=90,
+        )
+    except (OSError, subprocess.TimeoutExpired) as exc:
+        return False, str(exc)
+    if result.returncode != 0:
+        detail = (result.stderr or result.stdout or "import probe failed").strip()
+        return False, detail[-4000:]
+    try:
+        receipt = json.loads((result.stdout or "").strip())
+    except json.JSONDecodeError as exc:
+        return False, f"runtime probe returned an invalid receipt: {exc}"
+    if not isinstance(receipt, dict) or not all(
+        isinstance(key, str) and isinstance(value, str)
+        for key, value in receipt.items()
+    ):
+        return False, "runtime probe receipt is not a string mapping"
+    return True, receipt
+
+
+def _realize_dependencies(
+    tx: generation.UpdateTransaction,
+) -> tuple[bool, list[str], dict[str, str] | None]:
+    root = Path(tx.project_root)
+    prefix, env = _pip_prefix(root)
+
+    print("→ Realizing target-generation Python dependencies in a clean process...")
+    full = [*prefix, "-e", ".[all]"]
+    failures: list[str] = []
+    if _run(full, cwd=root, env=env) != 0:
+        print("  ⚠ Combined optional install failed; preserving the base install and retrying extras individually.")
+        if _run([*prefix, "-e", "."], cwd=root, env=env) != 0:
+            return False, ["base"], None
+
+        for group in _optional_groups(root):
+            if _run([*prefix, "-e", f".[{group}]"], cwd=root, env=env) != 0:
+                failures.append(group)
+                print(
+                    f"  ⚠ Optional dependency group {group!r} could not be refreshed; continuing with the verified base install.",
+                    file=sys.stderr,
+                )
+
+    verified, receipt_or_error = _verify_target_environment(root, env)
+    if not verified:
+        print(
+            "  ✗ Target environment import/provenance probe failed: "
+            + str(receipt_or_error),
+            file=sys.stderr,
+        )
+        return False, ["runtime-probe"], None
+    receipt = receipt_or_error
+    assert isinstance(receipt, dict)
+    print("  ✓ Target environment verified: " + json.dumps(receipt, sort_keys=True))
+    return True, failures, receipt
+
+
+def _main() -> int:
+    args = _parse_args()
+    journal = Path(args.journal).expanduser().resolve()
+    try:
+        token = os.environ.get(generation.TRANSACTION_TOKEN_ENV, "")
+        if not token:
+            raise generation.UpdateTransactionError(
+                "generation worker is missing its transaction capability"
+            )
+        tx = generation.read_transaction(journal, token=token)
+        _wait_for_predecessor_exit(tx)
+        generation.claim_transaction_marker(tx)
+        head = generation.current_head(Path(tx.project_root))
+        if head != tx.target_sha:
+            raise generation.UpdateTransactionError(
+                f"worker checkout is {head or 'unknown'}, expected {tx.target_sha}"
+            )
+        tx = generation.replace_transaction(
+            tx,
+            expected_phases={
+                "source_settled",
+                "dependency_handoff",
+                "dependencies_installing",
+            },
+            phase="dependencies_installing",
+            worker_pid=os.getpid(),
+            error=None,
+            exit_code=None,
+        )
+    except Exception as exc:
+        print(f"✗ Cannot resume update transaction: {exc}", file=sys.stderr)
+        return 1
+
+    incomplete = _write_incomplete_marker(Path(tx.project_root))
+    try:
+        ok, optional_failures, runtime_receipt = _realize_dependencies(tx)
+        if not ok:
+            generation.mark_failed(
+                tx,
+                "target-generation base dependency installation failed",
+                exit_code=1,
+            )
+            generation.remove_owned_marker(tx)
+            print(
+                "✗ Dependency realization failed. The source generation is settled and the durable journal was retained for diagnosis.",
+                file=sys.stderr,
+            )
+            return 1
+
+        try:
+            incomplete.unlink()
+        except OSError:
+            pass
+        tx = generation.replace_transaction(
+            tx,
+            expected_phases={"dependencies_installing"},
+            phase="dependencies_settled",
+            optional_dependency_failures=optional_failures,
+            runtime_receipt=runtime_receipt,
+            error=None,
+            exit_code=None,
+        )
+
+        command_args = list(tx.argv)
+        if not command_args or command_args[0] != "update":
+            command_args.insert(0, "update")
+        python = generation.venv_python(Path(tx.project_root))
+        argv = [str(python), "-m", "hermes_cli.main", *command_args]
+        env = generation.resume_environment(tx)
+        print("→ Dependency generation settled; continuing migrations, builds, and runtime activation in process N+1...")
+        for stream in (sys.stdout, sys.stderr):
+            try:
+                stream.flush()
+            except Exception:
+                pass
+        os.execve(argv[0], argv, env)
+        raise AssertionError("os.execve returned")
+    except SystemExit:
+        raise
+    except BaseException as exc:
+        try:
+            generation.mark_failed(tx, f"generation worker failed: {exc}", exit_code=1)
+            generation.remove_owned_marker(tx)
+        except Exception:
+            pass
+        print(f"✗ Generation worker failed: {exc}", file=sys.stderr)
+        return 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(_main())
