+def _race_for_update_lock(path: str, start, release, outcomes) -> None:
+    lock = UpdateLock(path=Path(path))
+    start.wait(timeout=10)
+    acquired = lock.acquire()
+    outcomes.put(acquired)
+    if acquired:
+        release.wait(timeout=10)
+        lock.release()
+
+
+def test_concurrent_claimants_have_exactly_one_owner(marker):
+    """The filesystem publication closes UpdateLock.acquire's TOCTOU."""
+    ctx = multiprocessing.get_context("spawn")
+    start = ctx.Event()
+    release = ctx.Event()
+    outcomes = ctx.Queue()
+    processes = [
+        ctx.Process(
+            target=_race_for_update_lock,
+            args=(str(marker), start, release, outcomes),
+        )
+        for _ in range(8)
+    ]
+    for process in processes:
+        process.start()
+    start.set()
+    results = [outcomes.get(timeout=15) for _ in processes]
+    release.set()
+    for process in processes:
+        process.join(timeout=15)
+        assert process.exitcode == 0
+
+    assert results.count(True) == 1
+    assert results.count(False) == 7
