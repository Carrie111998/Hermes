index 0000000000000000000000000000000000000000..5449c3431f7942b28d0fc87080734efe840876d5
--- /dev/null
+++ b/hermes_cli/update_generation.py
@@ -0,0 +1,630 @@
+"""Generation-bound update transaction support.
+
+This module is deliberately stdlib-only.  ``hermes update`` imports it in the
+old (pre-pull) interpreter, while ``update_generation_worker.py`` imports the
+same file after the checkout has moved.  Keeping the transaction vocabulary
+free of project and third-party imports is what lets the old process hand off
+mutation authority before any target-generation dependency is imported.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import errno
+import hmac
+import json
+import os
+import secrets
+import shutil
+import subprocess
+import sys
+import time
+import uuid
+from dataclasses import asdict, dataclass, field
+from pathlib import Path
+from typing import Any, Mapping, NoReturn, Sequence
+
+TRANSACTION_SCHEMA_VERSION = 1
+TRANSACTION_FILE_NAME = ".hermes-update-transaction.json"
+TRANSACTION_PATH_ENV = "HERMES_UPDATE_TRANSACTION"
+TRANSACTION_TOKEN_ENV = "HERMES_UPDATE_TRANSACTION_TOKEN"
+TRANSACTION_RESUME_ENV = "HERMES_UPDATE_GENERATION_RESUME"
+HANDOFF_PID_ENV = "HERMES_UPDATE_HANDOFF_PID"
+
+_PHASES = {
+    "source_settled",
+    "dependency_handoff",
+    "dependencies_installing",
+    "dependencies_settled",
+    "runtime_settling",
+    "complete",
+    "partial",
+    "failed",
+}
+
+
+class UpdateTransactionError(RuntimeError):
+    """The durable transaction cannot be trusted or advanced."""
+
+
+@dataclass(frozen=True)
+class UpdateTransaction:
+    schema_version: int
+    transaction_id: str
+    token: str
+    project_root: str
+    journal_path: str
+    marker_path: str
+    previous_sha: str
+    target_sha: str
+    branch: str
+    phase: str
+    parent_pid: int
+    argv: list[str]
+    created_at: float
+    updated_at: float
+    worker_pid: int | None = None
+    pre_update_version: str | None = None
+    pre_update_snapshot_id: str | None = None
+    had_desktop_app_before_update: bool = False
+    gateway_resume: Any = None
+    active_lazy_features: Any = field(default_factory=list)
+    active_tool_dependencies: Any = field(default_factory=list)
+    optional_dependency_failures: list[str] = field(default_factory=list)
+    runtime_receipt: dict[str, str] | None = None
+    exit_code: int | None = None
+    error: str | None = None
+
+    @classmethod
+    def from_mapping(cls, raw: Mapping[str, Any]) -> "UpdateTransaction":
+        try:
+            tx = cls(**dict(raw))
+        except (TypeError, ValueError) as exc:
+            raise UpdateTransactionError(f"invalid update transaction: {exc}") from exc
+        tx.validate()
+        return tx
+
+    def validate(self) -> None:
+        if self.schema_version != TRANSACTION_SCHEMA_VERSION:
+            raise UpdateTransactionError(
+                f"unsupported update transaction schema {self.schema_version}"
+            )
+        try:
+            uuid.UUID(self.transaction_id)
+        except (ValueError, TypeError) as exc:
+            raise UpdateTransactionError("invalid transaction id") from exc
+        if len(self.token) < 32:
+            raise UpdateTransactionError("transaction token is missing or too short")
+        if self.phase not in _PHASES:
+            raise UpdateTransactionError(f"unknown transaction phase {self.phase!r}")
+        if self.parent_pid <= 0:
+            raise UpdateTransactionError("invalid transaction parent pid")
+        if self.worker_pid is not None and self.worker_pid <= 0:
+            raise UpdateTransactionError("invalid transaction worker pid")
+        for label, sha in (
+            ("previous", self.previous_sha),
+            ("target", self.target_sha),
+        ):
+            if len(sha) != 40 or any(ch not in "0123456789abcdef" for ch in sha.lower()):
+                raise UpdateTransactionError(
+                    f"transaction {label} source generation is not a full Git SHA"
+                )
+        if not self.branch or any(ch in self.branch for ch in "\r\n\x00"):
+            raise UpdateTransactionError("transaction is missing a safe target branch")
+        if not isinstance(self.argv, list) or not all(
+            isinstance(arg, str) for arg in self.argv
+        ):
+            raise UpdateTransactionError("transaction argv must contain only strings")
+        if self.runtime_receipt is not None and (
+            not isinstance(self.runtime_receipt, dict)
+            or not all(
+                isinstance(key, str) and isinstance(value, str)
+                for key, value in self.runtime_receipt.items()
+            )
+        ):
+            raise UpdateTransactionError(
+                "transaction runtime receipt must be a string mapping"
+            )
+        root = Path(self.project_root)
+        journal = Path(self.journal_path)
+        marker = Path(self.marker_path)
+        if not root.is_absolute() or not journal.is_absolute() or not marker.is_absolute():
+            raise UpdateTransactionError("transaction paths must be absolute")
+        if journal.parent.resolve() != marker.parent.resolve():
+            raise UpdateTransactionError(
+                "transaction journal and shared marker must have one ownership root"
+            )
+
+
+def _json_safe(value: Any, fallback: Any) -> Any:
+    """Return ``value`` when it survives a JSON round trip, else ``fallback``."""
+    try:
+        return json.loads(json.dumps(value))
+    except (TypeError, ValueError, OverflowError):
+        return fallback
+
+
+def _default_hermes_home(project_root: Path) -> Path:
+    configured = os.environ.get("HERMES_HOME", "").strip()
+    if configured:
+        return Path(configured).expanduser().resolve()
+    # Managed/source installs place the checkout at <HERMES_HOME>/hermes-agent.
+    # Falling back to the parent keeps the journal outside the tree that Git or
+    # the ZIP swap mutates.
+    return project_root.resolve().parent
+
+
+def default_transaction_path(project_root: Path) -> Path:
+    return _default_hermes_home(project_root) / TRANSACTION_FILE_NAME
+
+
+def default_marker_path(project_root: Path) -> Path:
+    return _default_hermes_home(project_root) / ".hermes-update-in-progress"
+
+
+def _fsync_parent(path: Path) -> None:
+    if os.name == "nt":
+        return
+    try:
+        fd = os.open(path.parent, os.O_RDONLY)
+    except OSError:
+        return
+    try:
+        os.fsync(fd)
+    except OSError:
+        pass
+    finally:
+        os.close(fd)
+
+
+def atomic_write_json(path: Path, value: Mapping[str, Any]) -> None:
+    """Publish JSON atomically with owner-only permissions.
+
+    A transaction journal authorizes dependency and process mutation.  A
+    partially-written or world-readable journal is therefore not acceptable.
+    """
+    path = path.resolve()
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temp = path.with_name(
+        f".{path.name}.{os.getpid()}.{secrets.token_hex(8)}.tmp"
+    )
+    payload = json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n"
+    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
+    fd = os.open(temp, flags, 0o600)
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as handle:
+            handle.write(payload)
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.replace(temp, path)
+        try:
+            os.chmod(path, 0o600)
+        except OSError:
+            pass
+        _fsync_parent(path)
+    except BaseException:
+        try:
+            temp.unlink()
+        except OSError:
+            pass
+        raise
+
+
+def read_transaction(path: Path, *, token: str | None = None) -> UpdateTransaction:
+    unresolved = path.expanduser().absolute()
+    try:
+        if unresolved.is_symlink():
+            raise UpdateTransactionError("transaction journal must not be a symlink")
+        path = unresolved.resolve()
+        raw = json.loads(path.read_text(encoding="utf-8"))
+    except UpdateTransactionError:
+        raise
+    except (OSError, json.JSONDecodeError) as exc:
+        raise UpdateTransactionError(f"cannot read update transaction: {exc}") from exc
+    if not isinstance(raw, dict):
+        raise UpdateTransactionError("update transaction must be a JSON object")
+    tx = UpdateTransaction.from_mapping(raw)
+    if Path(tx.journal_path).resolve() != path:
+        raise UpdateTransactionError("journal path does not match transaction")
+    if token is not None and not hmac.compare_digest(tx.token, token):
+        raise UpdateTransactionError("update transaction token mismatch")
+    return tx
+
+
+def _pid_alive(pid: int) -> bool:
+    """Return whether ``pid`` exists without sending it a signal on Windows."""
+    if pid <= 0:
+        return False
+    if pid == os.getpid():
+        return True
+    if os.name == "nt":
+        # PROCESS_QUERY_LIMITED_INFORMATION.  OpenProcess fails for a dead PID;
+        # ERROR_ACCESS_DENIED still proves that a protected process exists.
+        process_query_limited_information = 0x1000
+        kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+        handle = kernel32.OpenProcess(
+            process_query_limited_information, False, int(pid)
+        )
+        if handle:
+            kernel32.CloseHandle(handle)
+            return True
+        return ctypes.get_last_error() == 5
+    try:
+        os.kill(pid, 0)  # windows-footgun: ok -- guarded by the POSIX-only branch above
+    except ProcessLookupError:
+        return False
+    except PermissionError:
+        return True
+    except (OSError, OverflowError, ValueError):
+        return False
+    return True
+
+
+def _publish_marker_exclusive(path: Path, payload: str) -> bool:
+    """Publish a complete marker without exposing a zero-byte owner file."""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temp = path.with_name(
+        f".{path.name}.{os.getpid()}.{secrets.token_hex(8)}.tmp"
+    )
+    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as handle:
+            handle.write(payload)
+            handle.flush()
+            os.fsync(handle.fileno())
+        try:
+            os.link(temp, path)
+        except FileExistsError:
+            return False
+        except OSError as exc:
+            if exc.errno in {errno.EEXIST, errno.EACCES}:
+                # EACCES is how some Windows filesystems surface an existing
+                # destination.  The caller re-reads and validates the owner.
+                if path.exists():
+                    return False
+            raise UpdateTransactionError(
+                f"cannot atomically publish shared update marker: {exc}"
+            ) from exc
+        return True
+    finally:
+        try:
+            temp.unlink()
+        except OSError:
+            pass
+
+
+def _read_marker_owner(path: Path) -> int | None:
+    try:
+        return int(path.read_text(encoding="utf-8").splitlines()[0].strip())
+    except (OSError, IndexError, ValueError):
+        return None
+
+
+def claim_transaction_marker(tx: UpdateTransaction) -> None:
+    """Transfer the shared update lock to this transaction process.
+
+    ``os.execve`` uses a new PID on Windows.  The durable journal proves the
+    handoff, but the process-wide marker still names process N.  Before any
+    dependency mutation, process N+1 removes only an authorized or dead owner
+    and wins a new atomic marker claim.  A live unrelated claimant fails the
+    update closed.
+    """
+    marker = Path(tx.marker_path)
+    authorized = {tx.parent_pid, os.getpid()}
+    if tx.worker_pid is not None:
+        authorized.add(tx.worker_pid)
+
+    try:
+        orchestrator = int(os.environ.get(HANDOFF_PID_ENV, "0") or 0)
+    except ValueError:
+        orchestrator = 0
+
+    for _attempt in range(16):
+        owner = _read_marker_owner(marker)
+        if owner == os.getpid():
+            return
+        if orchestrator > 0 and owner == orchestrator and _pid_alive(owner):
+            # The outer GUI updater owns the process-wide marker for the whole
+            # transaction.  Do not steal it; the orchestrator remains alive
+            # while this child stage runs and removes its own marker afterward.
+            return
+        if owner is not None and owner not in authorized and _pid_alive(owner):
+            raise UpdateTransactionError(
+                f"another live updater owns the shared marker (PID {owner})"
+            )
+        if marker.exists():
+            try:
+                marker.unlink()
+            except FileNotFoundError:
+                continue
+            except OSError as exc:
+                raise UpdateTransactionError(
+                    f"cannot retire the previous update marker: {exc}"
+                ) from exc
+
+        if _publish_marker_exclusive(
+            marker, f"{os.getpid()}\n{int(time.time())}\n"
+        ):
+            return
+
+    raise UpdateTransactionError(
+        "shared update marker ownership kept changing during generation handoff"
+    )
+
+
+def current_head(project_root: Path) -> str | None:
+    try:
+        result = subprocess.run(
+            ["git", "rev-parse", "HEAD"],
+            cwd=project_root,
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+            errors="replace",
+            timeout=15,
+        )
+    except (OSError, subprocess.TimeoutExpired):
+        return None
+    if result.returncode != 0:
+        return None
+    return result.stdout.strip() or None
+
+
+def create_transaction(
+    *,
+    project_root: Path,
+    previous_sha: str,
+    target_sha: str,
+    branch: str,
+    argv: Sequence[str],
+    pre_update_version: str | None,
+    pre_update_snapshot_id: str | None,
+    had_desktop_app_before_update: bool,
+    gateway_resume: Any,
+    active_lazy_features: Any,
+    active_tool_dependencies: Any,
+    journal_path: Path | None = None,
+    marker_path: Path | None = None,
+    now: float | None = None,
+) -> UpdateTransaction:
+    root = project_root.expanduser().resolve()
+    path = (journal_path or default_transaction_path(root)).expanduser().resolve()
+    marker = (marker_path or default_marker_path(root)).expanduser().resolve()
+    timestamp = time.time() if now is None else float(now)
+    tx = UpdateTransaction(
+        schema_version=TRANSACTION_SCHEMA_VERSION,
+        transaction_id=str(uuid.uuid4()),
+        token=secrets.token_urlsafe(32),
+        project_root=str(root),
+        journal_path=str(path),
+        marker_path=str(marker),
+        previous_sha=previous_sha,
+        target_sha=target_sha,
+        branch=branch,
+        phase="source_settled",
+        parent_pid=os.getpid(),
+        argv=list(argv),
+        created_at=timestamp,
+        updated_at=timestamp,
+        pre_update_version=pre_update_version,
+        pre_update_snapshot_id=pre_update_snapshot_id,
+        had_desktop_app_before_update=bool(had_desktop_app_before_update),
+        gateway_resume=_json_safe(gateway_resume, None),
+        active_lazy_features=_json_safe(active_lazy_features, []),
+        active_tool_dependencies=_json_safe(active_tool_dependencies, []),
+    )
+    tx.validate()
+    atomic_write_json(path, asdict(tx))
+    return tx
+
+
+def replace_transaction(
+    tx: UpdateTransaction,
+    *,
+    expected_phases: set[str] | None = None,
+    **changes: Any,
+) -> UpdateTransaction:
+    current = read_transaction(Path(tx.journal_path), token=tx.token)
+    if current.transaction_id != tx.transaction_id:
+        raise UpdateTransactionError("transaction generation changed")
+    if expected_phases is not None and current.phase not in expected_phases:
+        raise UpdateTransactionError(
+            f"cannot advance transaction from phase {current.phase!r}"
+        )
+    data = asdict(current)
+    data.update(changes)
+    data["updated_at"] = time.time()
+    updated = UpdateTransaction.from_mapping(data)
+    atomic_write_json(Path(updated.journal_path), asdict(updated))
+    return updated
+
+
+def discover_transaction(project_root: Path) -> UpdateTransaction | None:
+    """Load an unfinished journal, including crash-recovery discovery."""
+    env_path = os.environ.get(TRANSACTION_PATH_ENV, "").strip()
+    env_token = os.environ.get(TRANSACTION_TOKEN_ENV, "").strip() or None
+    path = Path(env_path) if env_path else default_transaction_path(project_root)
+    if not path.exists():
+        return None
+    tx = read_transaction(path, token=env_token)
+    if Path(tx.project_root).resolve() != project_root.resolve():
+        raise UpdateTransactionError("transaction belongs to another checkout")
+    if tx.phase in {"complete", "partial", "failed"}:
+        return None
+    head = current_head(project_root)
+    if head is None or head != tx.target_sha:
+        raise UpdateTransactionError(
+            "checkout generation does not match the durable update transaction"
+        )
+    return tx
+
+
+def venv_python(project_root: Path) -> Path:
+    candidates = (
+        project_root / "venv" / ("Scripts/python.exe" if os.name == "nt" else "bin/python"),
+        project_root / ".venv" / ("Scripts/python.exe" if os.name == "nt" else "bin/python"),
+    )
+    for candidate in candidates:
+        if candidate.is_file():
+            return candidate.resolve()
+    return Path(sys.executable).resolve()
+
+
+def worker_exec_argv(tx: UpdateTransaction) -> list[str]:
+    python = venv_python(Path(tx.project_root))
+    script = Path(__file__).with_name("update_generation_worker.py").resolve()
+    # ``-S`` prevents site initialization and editable-install .pth files
+    # from importing generation-N packages before the worker has settled N+1.
+    return [str(python), "-S", str(script), "--journal", tx.journal_path]
+
+
+def handoff_environment(tx: UpdateTransaction) -> dict[str, str]:
+    env = dict(os.environ)
+    env[TRANSACTION_PATH_ENV] = tx.journal_path
+    env[TRANSACTION_TOKEN_ENV] = tx.token
+    env.pop(TRANSACTION_RESUME_ENV, None)
+    env["PYTHONDONTWRITEBYTECODE"] = "1"
+    return env
+
+
+def begin_dependency_handoff(tx: UpdateTransaction) -> NoReturn:
+    """Replace process N with the stdlib-only dependency worker.
+
+    ``execve`` is load-bearing: process N must cease to exist before any file
+    in its venv can be replaced.  Spawning and waiting would keep N's mapped
+    native extensions alive; spawning and returning would break the caller's
+    completion/exit-code contract.
+    """
+    advanced = replace_transaction(
+        tx,
+        expected_phases={"source_settled", "dependency_handoff", "dependencies_installing"},
+        phase="dependency_handoff",
+        parent_pid=os.getpid(),
+        worker_pid=None,
+        error=None,
+        exit_code=None,
+    )
+    argv = worker_exec_argv(advanced)
+    env = handoff_environment(advanced)
+    for stream in (sys.stdout, sys.stderr):
+        try:
+            stream.flush()
+        except Exception:
+            pass
+    os.execve(argv[0], argv, env)
+    raise AssertionError("os.execve returned")
+
+
+def resume_environment(tx: UpdateTransaction) -> dict[str, str]:
+    env = dict(os.environ)
+    env[TRANSACTION_PATH_ENV] = tx.journal_path
+    env[TRANSACTION_TOKEN_ENV] = tx.token
+    env[TRANSACTION_RESUME_ENV] = "1"
+    return env
+
+
+def mark_runtime_settling(tx: UpdateTransaction) -> UpdateTransaction:
+    return replace_transaction(
+        tx,
+        expected_phases={"dependencies_settled", "runtime_settling"},
+        phase="runtime_settling",
+    )
+
+
+def settlement_partial_reasons(
+    tx: UpdateTransaction,
+    *,
+    active_executable: str,
+    node_failures: Sequence[str],
+    desktop_build_ok: bool,
+) -> list[str]:
+    """Explain why generation N+1 cannot be declared fully settled."""
+    reasons: list[str] = []
+    receipt_executable = (tx.runtime_receipt or {}).get("executable")
+    if not receipt_executable:
+        reasons.append(
+            "target Python runtime did not provide a durable provenance receipt"
+        )
+    elif os.path.normcase(os.path.realpath(receipt_executable)) != os.path.normcase(
+        os.path.realpath(active_executable)
+    ):
+        reasons.append(
+            "active Python runtime does not match the dependency-settlement receipt"
+        )
+    if tx.optional_dependency_failures:
+        reasons.append(
+            "Python optional groups failed: "
+            + ", ".join(tx.optional_dependency_failures)
+        )
+    if node_failures:
+        reasons.append("Node.js dependency refresh failed: " + ", ".join(node_failures))
+    if not desktop_build_ok:
+        reasons.append("Desktop realization did not settle")
+    return reasons
+
+
+def mark_complete(tx: UpdateTransaction) -> None:
+    updated = replace_transaction(
+        tx,
+        expected_phases={"runtime_settling", "dependencies_settled"},
+        phase="complete",
+        exit_code=0,
+        error=None,
+    )
+    remove_owned_marker(updated)
+    path = Path(updated.journal_path)
+    try:
+        path.unlink()
+        _fsync_parent(path)
+    except OSError:
+        # A terminal journal is safe to leave behind; discovery ignores it.
+        pass
+
+
+def mark_partial(tx: UpdateTransaction, reason: str, *, exit_code: int = 1) -> None:
+    replace_transaction(
+        tx,
+        expected_phases=None,
+        phase="partial",
+        exit_code=int(exit_code),
+        error=str(reason)[:4000],
+    )
+
+
+def mark_failed(tx: UpdateTransaction, error: str, *, exit_code: int = 1) -> None:
+    replace_transaction(
+        tx,
+        expected_phases=None,
+        phase="failed",
+        exit_code=int(exit_code),
+        error=str(error)[:4000],
+    )
+
+
+def remove_owned_marker(tx: UpdateTransaction) -> None:
+    """Remove the shared marker only when this process still owns it."""
+    marker = Path(tx.marker_path)
+    try:
+        lines = marker.read_text(encoding="utf-8").splitlines()
+        owner = int(lines[0].strip())
+    except (OSError, IndexError, ValueError):
+        return
+    if owner != os.getpid():
+        return
+    try:
+        marker.unlink()
+    except OSError:
+        pass
+
+
+def find_uv(project_root: Path) -> str | None:
+    home = _default_hermes_home(project_root)
+    executable = "uv.exe" if os.name == "nt" else "uv"
+    candidates = (
+        home / "bin" / executable,
+        project_root / ".hermes-runtime" / "bin" / executable,
+    )
+    for candidate in candidates:
+        if candidate.is_file():
+            return str(candidate.resolve())
+    return shutil.which(executable)
