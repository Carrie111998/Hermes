# ─────────────────────────────────────────────────────────────────────────
# 모아 — 카카오톡 법률상담 어시스턴트 환경변수
#
#   cp kakao_legal_bot/.env.example .env   후 값을 채우세요.
#   Railway 에서는 Variables 탭에 같은 키로 넣습니다.
#
# ⚠️ 이 파일에는 실제 키를 절대 적지 마세요. .env 는 커밋 금지입니다.
# ─────────────────────────────────────────────────────────────────────────

# ── 저장소 ────────────────────────────────────────────────────────────────
# Railway 에서는 볼륨을 /data 에 마운트하고 DATA_DIR=/data 로 두세요.
# 볼륨이 없으면 재배포할 때마다 대화 기록이 사라집니다.
DATA_DIR=./data
HISTORY_TURNS=24
HISTORY_RETENTION_DAYS=90

# ── Iris (에뮬레이터의 카카오톡 제어) ─────────────────────────────────────
# direct : 서버 → Iris 로 직접 전송 (Iris 가 외부에서 접근 가능해야 함)
# poll   : 서버는 큐에만 넣고, 에뮬레이터 옆의 relay/moa_relay.py 가 가져감
# hybrid : direct 시도 후 실패하면 큐로 (권장)
IRIS_SEND_MODE=hybrid
IRIS_BASE_URL=http://127.0.0.1:3000
IRIS_WEBHOOK_SECRET=change-me-long-random
OUTBOX_TOKEN=change-me-long-random
KAKAO_MAX_CHARS=900

# ── 호출 트리거 ───────────────────────────────────────────────────────────
BOT_NAME=모아
BOT_ALIASES=모아,moa,MOA,@모아
AUTO_ANSWER_DIRECT_ROOMS=true
IGNORE_SENDERS=

# ── 카카오 5초 룰 ─────────────────────────────────────────────────────────
# 답변이 이 시간 안에 끝나면 "찾아보는 중" 안내를 보내지 않습니다.
ACK_DEADLINE_MS=3500
# 여기까지 걸리면 포기하지 않고 "N분내로 답변드리겠습니다" 라고 알린 뒤
# ANSWER_EXTENSION_S 만큼 더 기다립니다. 그래도 못 끝내면 변호사에게 넘깁니다.
# 즉 실제 한도는 ANSWER_TIMEOUT_S + ANSWER_EXTENSION_S (기본 270초).
ANSWER_TIMEOUT_S=90
ANSWER_EXTENSION_S=180
# {minutes} 자리에 ANSWER_EXTENSION_S 를 분으로 환산한 값이 들어갑니다.
# PATIENCE_TEXT=답변을 생성하느라 시간이 걸리고 있습니다. {minutes}분내로 답변드리도록 하겠습니다. 잠시만 기다려주세요.
ROOM_COOLDOWN_S=2
ROOM_DAILY_CAP=60
GLOBAL_CONCURRENCY=4

# ── LLM ──────────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
# 문서 초안은 더 큰 모델로 뽑고 싶을 때만
LLM_DRAFT_MODEL=
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.2
LLM_MAX_TOOL_ROUNDS=4
PERSONA_PATH=./kakao_legal_bot/persona.md

# OpenAI 를 쓰거나 임베딩만 OpenAI 로 쓸 때
OPENAI_API_KEY=

# ── RAG (로컬 주석서·법률서적) ────────────────────────────────────────────
CORPUS_DIR=./corpus
RAG_TOP_K=6
RAG_CHUNK_CHARS=900
RAG_EMBEDDINGS=false
RAG_EMBEDDING_MODEL=text-embedding-3-small

# ── 국가법령정보 / 공공데이터포털 ─────────────────────────────────────────
# LAW_OC        : open.law.go.kr 에 등록한 이메일의 @ 앞부분 (예: kjccjk)
# DATA_GO_KR_KEY: data.go.kr 인증키. "디코딩" 키를 넣으세요.
#                 (%2F 같은 인코딩 키를 넣어도 서버가 한 번 디코딩합니다)
LAW_OC=
DATA_GO_KR_KEY=
LAW_API_ENABLED=true
LAW_CACHE_TTL_S=86400

# ── 변호사 / 관리 ─────────────────────────────────────────────────────────
LAWYER_NAME=김변호사
# 변호사 본인과의 카톡방 chat_id (초안·에스컬레이션 알림이 갑니다)
LAWYER_ROOM_ID=
LAWYER_EMAIL=
# 변호사 본인의 카카오 user_id 또는 표시이름 (상담방에서 /개입 등을 쓰려면 필요)
LAWYER_KAKAO_IDS=
# 배포된 서버의 공개 주소 (초안 검토 링크에 사용)
PUBLIC_BASE_URL=
ADMIN_TOKEN=change-me-long-random

# ── 최종 문서 발송 메일 ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

# ── 기타 ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# 발신자 식별자를 해싱할 때 쓰는 소금값. 바꾸면 과거 기록과 연결이 끊깁니다.
PSEUDONYM_SALT=change-me
# true 로 두면 대화 기록에 카카오 표시이름을 그대로 저장합니다 (기본 false)
STORE_RAW_SENDER=false
