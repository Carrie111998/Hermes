# syntax=docker/dockerfile:1
#
# Dockerfile for the interfaze-agent Sales Agent API (`interfaze-api`).
#
# This is NOT the upstream Hermes gateway image — that one is ./Dockerfile
# (s6-overlay, gateway + dashboard services). This image ships exactly one
# process: the FastAPI product API defined in server/app.py, plus a working
# `hermes` CLI on PATH because server/agent_service.py shells out to it
# (`hermes -z <prompt> --skills <skill> --yolo`) and /health reports
# `agent_runs_enabled` from `shutil.which("hermes")`.
#
# Build:
#   docker build -f Dockerfile.interfaze-api -t interfaze-api:local .
# Run:
#   docker compose -f docker-compose.interfaze.yml up -d
#
# Notes / deliberate choices:
#   * Python is pinned to 3.13 — pyproject requires ">=3.11,<3.14" and 3.13
#     matches what the upstream image and `[tool.ty.environment]` target.
#   * Dependencies come from uv.lock (`uv sync --locked`), so the image ships
#     the exact pinned set CI resolved. `--locked` (not `--frozen`) makes a
#     stale lockfile a build failure instead of a silently-wrong image — the
#     failure mode we hit when uv.lock's `interfaze` extra was missing
#     ddgs / scrapling / markdownify and the lead-discovery skill shipped with
#     no web-search backend.
#   * server/api_cli.py defaults to 127.0.0.1; we pass --host on the command
#     line (see CMD) instead of patching the file.
#   * Writable state (SQLite DB, uploads, hermes home, synced skills) all
#     lives under /data, which is a volume.

ARG PYTHON_VERSION=3.13
ARG UV_VERSION=0.11.6


# ---------------------------------------------------------------------------
# uv — used only as a fast pip replacement during the build.
# ---------------------------------------------------------------------------
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv


# ---------------------------------------------------------------------------
# Builder: resolve + install the wheel into a self-contained venv at /opt/venv
# ---------------------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim-trixie AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON=/usr/local/bin/python3 \
    UV_PYTHON_DOWNLOADS=never
# UV_PROJECT_ENVIRONMENT: `uv sync` writes to the project environment; point
#   that at the venv the runtime stage copies out instead of /src/.venv.
# UV_PYTHON / UV_PYTHON_DOWNLOADS: the base image's interpreter is already the
#   pinned 3.13, so don't let uv fetch a second managed toolchain into the layer.

COPY --from=uv /uv /usr/local/bin/uv

# Toolchain safety net: every direct dependency publishes manylinux wheels for
# cp313, but a transitive sdist (or a future pin bump) must not turn the build
# into a mystery failure. Builder-stage only — none of this reaches the runtime.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libffi-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . /src

# `[web]` = fastapi/uvicorn/starlette/python-multipart.
# `[interfaze]` = asyncpg + the web-research stack the lead-discovery skill
# needs (ddgs, scrapling[fetchers], markdownify).
#
# `--no-editable` installs the project as a built wheel rather than a .pth
# pointing back at /src, which the runtime stage does not carry — an editable
# install would produce a venv that ImportErrors the moment it's copied out.
# `--no-dev` keeps pytest/ruff/ty out of the shipped image.
RUN uv sync --locked --no-dev --no-editable --extra web --extra interfaze

# Fail the build here rather than at container start if either console script
# or the app package went missing.
RUN test -x /opt/venv/bin/interfaze-api \
    && test -x /opt/venv/bin/hermes \
    && /opt/venv/bin/python -c "import server.app, tools.skills_sync"


# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim-trixie AS runtime

# git + ripgrep are used by hermes' own tooling; curl backs the healthcheck;
# tini reaps the `hermes` subprocesses HermesProcessExecutor spawns (uvicorn
# as PID 1 would leave zombies behind on the kill/timeout paths).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        procps \
        ripgrep \
        tini \
    && rm -rf /var/lib/apt/lists/*

# Pin the ENTRYPOINT binary to a path this file owns, and assert it runs. A
# hardcoded ENTRYPOINT that is missing or non-executable fails at *exec* time,
# which surfaces as a bare "failed to spawn command: ... No such file or
# directory" and a restart loop with no application log — cheaper to catch here.
RUN ln -sf "$(command -v tini)" /usr/local/bin/tini && /usr/local/bin/tini --version

COPY --from=builder /opt/venv /opt/venv

# Bundled skills are NOT shipped inside the wheel (pyproject's
# [tool.setuptools.data-files] covers locales/ and optional-mcps/ only), and
# server/run_types.py dispatches to skills/sales/* — document-processing,
# company-brain-build, lead-discovery, lead-research, contact-discovery,
# cold-email-outreach, whatsapp-outreach, linkedin-notes. Copy the source
# trees in and point hermes_constants' override env vars at them; the CMD
# then syncs them into $HERMES_HOME/skills, which is where
# agent/skill_utils.py actually looks.
COPY --from=builder /src/skills /opt/interfaze/skills
COPY --from=builder /src/optional-skills /opt/interfaze/optional-skills

# Seed for $HERMES_HOME/config.yaml. Both consumers of that file read it at
# startup and fall back to defaults when it is missing — server/config.py to
# auth_mode local with an EMPTY chat_model, and the hermes CLI to provider
# auto-detection. Neither failure is loud, so a fresh volume would come up
# serving traffic with chat pointed at the wrong model. The CMD copies this in
# only when the file is absent, so an operator's edits are never overwritten.
COPY --from=builder /src/server/config.yaml.example /opt/interfaze/config.yaml.default

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:${PATH}" \
    HERMES_HOME=/data \
    HERMES_WRITE_SAFE_ROOT=/data \
    HERMES_BUNDLED_SKILLS=/opt/interfaze/skills \
    HERMES_OPTIONAL_SKILLS=/opt/interfaze/optional-skills

# /opt/venv is root-owned and immutable at runtime, so a lazy install must
# never try to mutate it. The interfaze extra already preinstalls every
# backend this service uses.
ENV HERMES_DISABLE_LAZY_INSTALLS=1

# Defaults for the vars server/config.py reads. Everything here can be
# overridden by --env-file / -e at run time; the secrets deliberately have NO
# default (see docker-compose.interfaze.yml).
ENV INTERFAZE_DATABASE_PATH=/data/interfaze/interfaze.db \
    INTERFAZE_PUBLIC_BASE_URL=http://localhost:8000 \
    INTERFAZE_HOST=0.0.0.0 \
    INTERFAZE_PORT=8000

# uid/gid 10001 to avoid colliding with the upstream image's hermes user
# (10000). Docker seeds a fresh named volume from the image directory it is
# mounted over, ownership included, so /data stays writable for this user.
# Other runtimes do NOT: a Fly volume mounts as an empty filesystem (it applies
# the uid/gid, but creates no directories), so the layout below exists only for
# the compose path and the CMD recreates it at boot.
RUN groupadd --gid 10001 interfaze \
    && useradd --uid 10001 --gid 10001 --create-home --shell /bin/bash interfaze \
    && mkdir -p /data/interfaze/uploads /data/workspace \
    && chown -R interfaze:interfaze /data

USER interfaze
# NOT /data/workspace: that path lives under the volume mount point, so on a
# fresh volume it does not exist at spawn time and the container fails to start
# with a bare ENOENT — no application log, just a restart loop. The CMD creates
# the directory and cd's into it once the mount is live.
WORKDIR /opt/interfaze

EXPOSE 8000
VOLUME ["/data"]

# Exec form (DL3025). The shell is explicit because the probe needs
# ${INTERFAZE_PORT} expanded at run time, which exec form alone won't do.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD ["/bin/sh", "-c", "curl -fsS \"http://127.0.0.1:${INTERFAZE_PORT:-8000}/health\" || exit 1"]

ENTRYPOINT ["/usr/local/bin/tini", "--"]
# Recreate the /data layout first: on a mounted volume the image's directories
# are shadowed, and the agent workspace, upload dir, and SQLite parent must all
# exist before the app touches them. mkdir -p is a no-op on the compose path
# where the volume was seeded from the image. Then seed config.yaml if and only
# if it does not already exist — -e rather than -f so a symlinked config is also
# left alone.
#
# Then sync bundled skills into $HERMES_HOME/skills (idempotent; user edits
# under /data are preserved by skills_sync's manifest) and hand PID 1 to uvicorn.
# `--host` comes from INTERFAZE_HOST because server/api_cli.py's argparse
# default is 127.0.0.1, which would be unreachable from outside the container.
CMD ["sh", "-c", "mkdir -p /data/interfaze/uploads /data/workspace && cd /data/workspace && { [ -e \"${HERMES_HOME:-/data}/config.yaml\" ] || { cp /opt/interfaze/config.yaml.default \"${HERMES_HOME:-/data}/config.yaml\" && echo \"[interfaze] seeded ${HERMES_HOME:-/data}/config.yaml from image default\"; }; }; { python -m tools.skills_sync || echo '[interfaze] warning: skills sync failed; continuing'; }; exec interfaze-api --host \"${INTERFAZE_HOST:-0.0.0.0}\" --port \"${INTERFAZE_PORT:-8000}\""]
