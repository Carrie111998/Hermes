+def _kimi_plan_label(payload: Any) -> Optional[str]:
+    level = str(
+        (((payload.get("user") or {}).get("membership") or {}).get("level")) or ""
+    ).strip()
+    if not level:
+        return None
+    return _title_case_slug(level.removeprefix("LEVEL_"))
+
