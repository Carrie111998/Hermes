      ],
      "hard_failover": [
        "deepseek/deepseek-v4-flash"
      ],
      "router_failure_action": "fast_gate_conservative"
    },
    "local-deterministic": {
      "primary": "ollama/qwen3-vl:2b",
      "soft_failover": [],
      "hard_failover": []
    },
    "fast-economy": {
