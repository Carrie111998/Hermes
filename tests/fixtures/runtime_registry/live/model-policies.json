        "minimax-cn/MiniMax-M3"
      ],
      "primary_pool_mode": "flexible_available_primary",
      "soft_failover": [
        "openai-codex/gpt-5.6-luna"
      ],
      "hard_failover": [
        "deepseek/deepseek-v4-flash"
      ]
    },
    "standard-reasoning": {
