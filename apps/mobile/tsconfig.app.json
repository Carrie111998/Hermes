{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["../desktop/src/*"],
      "@hermes/shared": ["../shared/src/index.ts"],
      "@hermes/shared/*": ["../shared/src/*"],
      "@hermes/plugin-sdk": ["../desktop/src/sdk/index.ts"],
      "~mobile/*": ["./src/mobile/*"],
      "~bridge/*": ["./src/bridge/*"]
    }
  },
  "include": ["src"]
}
