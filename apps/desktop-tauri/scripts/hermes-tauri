#!/bin/bash
# Hermes Tauri launcher — connects to shared systemd-managed backend.
# Backend lifecycle managed by: systemctl --user hermes-serve.service

HERMES_HOME="$HOME/.hermes"
HERMES_AGENT="$HERMES_HOME/hermes-agent"
TAURI_BINARY="$HERMES_AGENT/apps/desktop-tauri/src-tauri/target/debug/hermes-tauri"
PIDFILE="/tmp/hermes-tauri.pid"

log() { echo "[hermes-tauri] $*"; notify-send "Hermes Tauri" "$*" 2>/dev/null || true; }

# --- integrity check - catch *** corruptions in Python backend ---
PYTHON_CORRUPT=$(python3 -c "
import py_compile, glob, sys
bad = []
for f in glob.glob('$HERMES_AGENT/hermes_cli/*.py'):
    try:
        py_compile.compile(f, doraise=True)
    except py_compile.PyCompileError as e:
        bad.append(f.split('/')[-1] + ':' + str(e).split('line ')[-1].split(')')[0])
if bad:
    print('; '.join(bad))
    sys.exit(1)
" 2>&1)
if [ -n "$PYTHON_CORRUPT" ]; then
  log "*** corruption in Python backend -- fix before launch"
  echo "$PYTHON_CORRUPT"
  exit 1
fi

# NVIDIA guard
if [ -f /proc/driver/nvidia/version ] && command -v modinfo >/dev/null 2>&1; then
  LOADED=$(awk '{print $8}' /proc/driver/nvidia/version 2>/dev/null | head -1)
  ONDISK=$(modinfo -F version nvidia 2>/dev/null | head -1)
  if [ -n "$LOADED" ] && [ -n "$ONDISK" ] && [ "$LOADED" != "$ONDISK" ]; then
    log "NVIDIA driver mismatch -- reboot required."
    exit 1
  fi
fi

# PID lock
if [ -f "$PIDFILE" ]; then
  LOCK_PID=$(cat "$PIDFILE")
  if kill -0 "$LOCK_PID" 2>/dev/null; then
    log "Already running. Exiting."
    exit 0
  fi
  rm -f "$PIDFILE"
fi
echo $$ > "$PIDFILE"
cleanup() { rm -f "$PIDFILE"; }
trap cleanup EXIT INT TERM

# --- Read shared token from systemd-managed backend ---
TOKEN_FILE="$HOME/.hermes/runtime/backend-token"
if [ -f "$TOKEN_FILE" ]; then
  SECRET=$(cat "$TOKEN_FILE")
  export HERMES_DASHBOARD_SESSION_TOKEN="$SECRET"
  log "Connected to shared backend on :44985"
else
  log "ERROR: No backend-token found at $TOKEN_FILE"
  log "Run: systemctl --user start hermes-serve"
  exit 1
fi

# --- Backend liveness check ---
# Verify backend TCP port is listening
if ! ss -tlnp 2>/dev/null | grep -q ':44985'; then
  log "ERROR: Backend port 44985 not listening"
  log "Run: systemctl --user start hermes-serve"
  systemctl --user start hermes-serve.service 2>/dev/null
  sleep 2
  if ! ss -tlnp 2>/dev/null | grep -q ':44985'; then
    log "Backend still not running after restart attempt"
    log "Run manually: systemctl --user start hermes-serve"
    exit 1
  fi
  log "Backend restarted successfully"
fi

# Verify WS connectivity with actual token
# Tests both port reachability AND token validity
WS_CHECK=$(timeout 5 python3 -c "
import asyncio, websockets, sys
async def check():
    token = '$SECRET'
    url = f'ws://127.0.0.1:44985/api/ws?token={token}'
    try:
        async with websockets.connect(url, ping_interval=None, open_timeout=4) as ws:
            msg = await asyncio.wait_for(ws.recv(), timeout=2)
            if 'gateway.ready' in msg:
                sys.exit(0)
            else:
                sys.exit(2)
    except Exception as e:
        print(f'WS failed: {e}')
        sys.exit(1)
asyncio.run(check())
" 2>&1)
WS_EXIT=$?
if [ "$WS_EXIT" -ne 0 ]; then
  log "ERROR: Backend WS check failed (exit=$WS_EXIT)"
  echo "$WS_CHECK"
  log "Retrying in 3s..."
  sleep 3
  WS_CHECK=$(timeout 5 python3 -c "
import asyncio, websockets, sys
async def check():
    token = '$SECRET'
    url = f'ws://127.0.0.1:44985/api/ws?token={token}'
    try:
        async with websockets.connect(url, ping_interval=None, open_timeout=4) as ws:
            msg = await asyncio.wait_for(ws.recv(), timeout=2)
            if 'gateway.ready' in msg:
                sys.exit(0)
            else:
                sys.exit(2)
    except Exception as e:
        print(f'WS failed: {e}')
        sys.exit(1)
asyncio.run(check())
" 2>&1)
  WS_EXIT=$?
  if [ "$WS_EXIT" -ne 0 ]; then
    log "Backend WS check failed after retry -- aborting"
    echo "$WS_CHECK"
    exit 1
  fi
fi
log "Backend WS check passed"

# WebKit workaround + profile (Linux stability)
export WEBKIT_DISABLE_COMPOSITING_MODE=1
export WEBKIT_FORCE_COMPLEX_TEXT=1
export GDK_BACKEND=x11
export HERMES_PROFILE="${HERMES_PROFILE:-dimitri}"

# Start dev server for dist (release binary may still use devUrl on WebKitGTK)
DIST_DIR="$HERMES_AGENT/apps/desktop-tauri/dist"
DEV_SERVER_PID=""
if ! ss -tlnp 2>/dev/null | grep -q ':5173'; then
  python3 -m http.server 5173 --directory "$DIST_DIR" &>/dev/null &
  DEV_SERVER_PID=$!
  disown "$DEV_SERVER_PID" 2>/dev/null
  log "Dev server started on :5173 for dist"
fi

log "Launching Tauri..."
"$TAURI_BINARY"

# Clean up dev server on exit
if [ -n "$DEV_SERVER_PID" ]; then
  kill "$DEV_SERVER_PID" 2>/dev/null || true
fi
