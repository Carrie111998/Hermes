+class TestMainTurnAck:
+    """Cover the receipt sent when an inbound starts the main turn.
+
+    See gateway/run.py::_maybe_send_main_turn_ack — same 30s debounce
+    as busy/queue ACK, same master gate, opt-out via
+    HERMES_GATEWAY_BUSY_MAIN_ACK_ENABLED or per-platform config.
+    """
+
+    @pytest.mark.asyncio
+    async def test_main_turn_ack_sends_processing_receipt(self, monkeypatch):
+        import gateway.run as _gr
+
+        monkeypatch.delenv("HERMES_GATEWAY_BUSY_MAIN_ACK_ENABLED", raising=False)
+        monkeypatch.delenv("HERMES_GATEWAY_BUSY_ACK_ENABLED", raising=False)
+        monkeypatch.setattr(_gr, "_load_gateway_config", lambda: {})
+
+        runner, _ = _make_runner()
+        adapter = _make_adapter()
+        event = _make_event(text="first ever message this session")
+        sk = build_session_key(event.source)
+        runner.adapters[event.source.platform] = adapter
+
+        await runner._maybe_send_main_turn_ack(event, sk)
+
+        adapter._send_with_retry.assert_called_once()
+        content = adapter._send_with_retry.call_args.kwargs.get("content", "")
+        assert "Working" in content, f"expected main-turn marker, got: {content!r}"
+        assert "\u5904\u7406\u4e2d" in content or "处理中" in content, (
+            f"expected 处理中 marker, got: {content!r}"
+        )
+        assert "first ever" in content, (
+            f"expected message preview, got: {content!r}"
+        )
+
+    @pytest.mark.asyncio
+    async def test_main_turn_ack_debounced_within_window(self, monkeypatch):
+        import gateway.run as _gr, time as _time
+
+        monkeypatch.delenv("HERMES_GATEWAY_BUSY_MAIN_ACK_ENABLED", raising=False)
+        monkeypatch.delenv("HERMES_GATEWAY_BUSY_ACK_ENABLED", raising=False)
+        monkeypatch.setattr(_gr, "_load_gateway_config", lambda: {})
+
+        runner, _ = _make_runner()
+        adapter = _make_adapter()
+        event = _make_event(text="hello")
+        sk = build_session_key(event.source)
+        runner.adapters[event.source.platform] = adapter
+
+        # Prime the debounce window as if an earlier ACK just fired.
+        runner._busy_ack_ts[sk] = _time.time()
+
+        await runner._maybe_send_main_turn_ack(event, sk)
+
+        adapter._send_with_retry.assert_not_called()
+
+    @pytest.mark.asyncio
+    async def test_main_turn_ack_opt_out_via_env(self, monkeypatch):
+        import gateway.run as _gr
+
+        monkeypatch.setenv("HERMES_GATEWAY_BUSY_MAIN_ACK_ENABLED", "false")
+        monkeypatch.setattr(_gr, "_load_gateway_config", lambda: {})
+
+        runner, _ = _make_runner()
+        adapter = _make_adapter()
+        event = _make_event(text="silent path")
+        sk = build_session_key(event.source)
+        runner.adapters[event.source.platform] = adapter
+
+        await runner._maybe_send_main_turn_ack(event, sk)
+
+        adapter._send_with_retry.assert_not_called()
+
+    @pytest.mark.asyncio
+    async def test_main_turn_ack_skipped_for_internal_events(self, monkeypatch):
+        """Background-process completions etc. must not surface a receipt."""
+        import gateway.run as _gr
+
+        monkeypatch.delenv("HERMES_GATEWAY_BUSY_MAIN_ACK_ENABLED", raising=False)
+        monkeypatch.setattr(_gr, "_load_gateway_config", lambda: {})
+
+        runner, _ = _make_runner()
+        adapter = _make_adapter()
+        event = _make_event(text="[Background process ... completed]")
+        # Real internal events set this flag; simulate.
+        event.internal = True
+        sk = build_session_key(event.source)
+        runner.adapters[event.source.platform] = adapter
+
+        await runner._maybe_send_main_turn_ack(event, sk)
+
+        adapter._send_with_retry.assert_not_called()
+
+    @pytest.mark.asyncio
+    async def test_main_turn_ack_master_switch_off(self, monkeypatch):
+        import gateway.run as _gr
+
+        monkeypatch.setenv("HERMES_GATEWAY_BUSY_ACK_ENABLED", "false")
+        monkeypatch.setattr(_gr, "_load_gateway_config", lambda: {})
+
+        runner, _ = _make_runner()
+        adapter = _make_adapter()
+        event = _make_event(text="anything")
+        sk = build_session_key(event.source)
+        runner.adapters[event.source.platform] = adapter
+
+        await runner._maybe_send_main_turn_ack(event, sk)
+
+        adapter._send_with_retry.assert_not_called()
