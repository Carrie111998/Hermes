#!/usr/bin/env bash
set -euo pipefail

session_env=/home/hermes/.desktop-session-env
if [ -f "$session_env" ]; then
  # Generated by start-desktop.sh from dbus-launch output.
  # shellcheck disable=SC1090
  . "$session_env"
  export DBUS_SESSION_BUS_ADDRESS DBUS_SESSION_BUS_PID
fi

export DISPLAY="${DISPLAY:-:1}"
export HOME=/home/hermes
exec /home/hermes/.local/bin/cua-driver "$@"
